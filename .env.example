# QBT local configuration template.
# Copy this to .env and fill only the provider(s) you use.
# NEVER commit .env or real credentials.

# ---------------- IBM Quantum ----------------
# API key from IBM Quantum Platform. QBT also supports a previously saved
# Qiskit Runtime account, so this may be omitted in that case.
IBM_QUANTUM_TOKEN=
# Recommended IBM service instance/CRN.
IBM_QUANTUM_INSTANCE=
# Optional. Blank lets QBT select an operational hardware backend.
IBM_QUANTUM_BACKEND=

# ---------------- Azure Quantum ----------------
# Recommended workspace locator.
AZURE_QUANTUM_RESOURCE_ID=
# Alternative workspace locator if resource ID is not used.
AZURE_SUBSCRIPTION_ID=
AZURE_QUANTUM_RESOURCE_GROUP=
AZURE_QUANTUM_WORKSPACE=
# Provider/target passed to your Azure runner.
AZURE_QUANTUM_TARGET=

# Microsoft Entra service-principal auth (optional).
# Azure CLI / DefaultAzureCredential can be used instead.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Compatibility option. Microsoft recommends Entra authorization instead of
# storing workspace access keys/connection strings in plaintext.
AZURE_QUANTUM_CONNECTION_STRING=
