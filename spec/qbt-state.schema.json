{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbt.local/spec/qbt-state.schema.json",
  "title": "QBT QuantumState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qbt_version",
    "provider",
    "backend",
    "execution_mode",
    "timestamp",
    "job_id",
    "shots",
    "entropy",
    "normalized_vector",
    "result_digest",
    "provenance",
    "quality"
  ],
  "properties": {
    "qbt_version": {"type": "string", "const": "1.0"},
    "provider": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "execution_mode": {
      "type": "string",
      "enum": ["hardware", "simulator", "archive", "fallback"]
    },
    "timestamp": {"type": "string", "minLength": 1},
    "job_id": {"type": ["string", "null"]},
    "shots": {"type": "integer", "minimum": 0},
    "entropy": {"type": "number", "minimum": 0, "maximum": 1},
    "normalized_vector": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object"},
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": ["quality_class", "confidence"],
      "properties": {
        "quality_class": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
